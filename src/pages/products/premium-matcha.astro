---
import SiteLayout from "../../layouts/IssaLayout.astro";
import "../../styles/shop.css";
---

<SiteLayout title="Premium Matcha 30g | Issa Green" description="Premium Matcha 30g | Issa Green">
<section class="pdp">
    <div class="section-wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/shop-tea">Tea</a><span>›</span><span aria-current="page">Premium Matcha 30g</span></nav>
      <div class="pdp-grid">
        <div class="pdp-gallery">
          <div class="pdp-main"><img id="pdp-main" src="/images/shop/premium-matcha-30g.jpg" alt="Premium Matcha 30g"></div>
          <div class="pdp-thumbs" id="pdp-thumbs"></div>
        </div>
        <div class="pdp-info">
          <div class="pdp-ribbons"></div>
          <h1>Premium Matcha 30g</h1>
          <p class="pdp-sub">Matcha · Ishikawa farm · Toyota, Aichi</p>
          <div class="pdp-price" id="pdp-price" aria-live="polite"></div>
          <div class="pdp-opt" id="pdp-opt"></div>
          <div class="pdp-buy">
            <div class="qty" role="group" aria-label="Quantity"><button type="button" id="q-dec" aria-label="Decrease quantity">−</button><output id="q-out" aria-live="polite">1</output><button type="button" id="q-inc" aria-label="Increase quantity">+</button></div>
            <button class="pdp-add" id="pdp-add" type="button"></button>
          </div>
          <p class="pdp-msg" id="pdp-msg" role="alert" hidden></p>
          <p class="pdp-note">Shipping and taxes calculated at checkout. <a href="/shipping">Shipping &amp; returns</a></p>
          <p class="pdp-lead">Because it is difficult to obtain genuine matcha outside of Japan, we are especially proud to offer this genuine matcha grown by a specialist farmer using organic methods.</p>
          <div class="pdp-tags"><span class="pdp-tag t0">Health &amp; Beauty</span><span class="pdp-tag t1">Energy boost</span><span class="pdp-tag t2">Rich flavor</span></div>
          <div class="acc-list"><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc0">About this tea<span aria-hidden="true"></span></button><div class="acc-panel" id="acc0" role="region"><div class="acc-in"><p>Matcha is known as a Japanese super food: rich in catechin, β-carotene, vitamin E, K, B vitamins, vitamin C, folic acid, niacin and minerals. Popular for immune support and anti-aging worldwide. Called the Japanese espresso — high in caffeine, great for starting your day.</p></div></div></div><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc1">How to brew<span aria-hidden="true"></span></button><div class="acc-panel" id="acc1" role="region"><div class="acc-in"><p>1 tsp / 70–100 ml. For sweetness, brew at lower temperature.</p></div></div></div><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc2">Product details<span aria-hidden="true"></span></button><div class="acc-panel" id="acc2" role="region"><div class="acc-in"><p><strong>Ingredients</strong> Organic green tea</p><p><strong>Producer</strong> Ishikawa farm</p><p><strong>Available</strong> For traditional way</p><p>We don&#x27;t use canned packaging to reduce CO₂ emissions.</p></div></div></div><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc3">Shipping info<span aria-hidden="true"></span></button><div class="acc-panel" id="acc3" role="region"><div class="acc-in"><p><strong>Calgary</strong> Within Calgary city limit: $7 flat rate. Free delivery over $75.</p><p><strong>Rest of Canada</strong> $12 flat rate shipping by Canada Post or courier service. Free shipping over $150.</p><p>If you prefer another shipping method, please do not hesitate to contact us. We will arrange a special shipment.</p></div></div></div><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc4">Return &amp; refund policy<span aria-hidden="true"></span></button><div class="acc-panel" id="acc4" role="region"><div class="acc-in"><p><strong>Tea</strong> Due to the character of our products, we cannot accept returns or refunds of packaged tea and food.</p><p><strong>Tea ware &amp; goods</strong> We accept returns and issue a gift card for the same amount as the purchased goods. Customers pay the postage for returns.</p><p>Please inform us about defects immediately by email at <a href="mailto:issagreentea@gmail.com">issagreentea@gmail.com</a>. We will make an exchange as soon as possible.</p><p>Most of our products are handcrafted and have unique characters. We are happy to tell you the exact condition of each item before shipping. Please leave the request on the checkout page.</p></div></div></div></div>
        </div>
      </div>
    </div>
  </section>
  <section class="pdp-rel"><div class="section-wrap"><p class="section-label">More tea</p><div class="rel-grid"><a class="rel-card" href="/products/fukamushi-sencha"><span class="rel-img"><img src="/images/shop/fukamushi-sencha-bags.jpg" alt="" loading="lazy"></span><span class="rel-name">Fukamushi sencha</span><span class="rel-price">From $22.00</span></a><a class="rel-card" href="/products/premium-sencha"><span class="rel-img"><img src="/images/shop/premium-sencha-80g.jpg" alt="" loading="lazy"></span><span class="rel-name">Premium sencha</span><span class="rel-price">$24.50</span></a><a class="rel-card" href="/products/gyokuro"><span class="rel-img"><img src="/images/shop/gyokuro-30g.jpg" alt="" loading="lazy"></span><span class="rel-name">Gyokuro</span><span class="rel-price">Out of stock</span></a><a class="rel-card" href="/products/fukamushi-genmaicha"><span class="rel-img"><img src="/images/shop/fukamushi-genmaicha-80g.jpg" alt="" loading="lazy"></span><span class="rel-name">Fukamushi Genmaicha</span><span class="rel-price">From $19.80</span></a></div>
    <p style="text-align:center;margin-top:36px"><a class="btn-explore" href="/shop-tea">All tea</a></p></div></section>
  
  
<script is:inline>window.PDP = {"name": "Premium Matcha 30g", "optname": null, "variants": [{"id": "premium-matcha-30g-for-traditional-way", "label": "For traditional way", "price": 30.0, "was": 36.0, "soldout": false, "img": "/images/shop/premium-matcha-30g.jpg", "imgs": ["/images/shop/premium-matcha-30g.jpg", "/images/shop/premium-matcha-30g-hover.jpg"], "name": "Premium Matcha 30g", "variant": "for traditional way"}]};</script>
<script is:inline src="/pdp.js"></script>
</SiteLayout>
