---
import SiteLayout from "../../layouts/IssaLayout.astro";
import "../../styles/shop.css";
---

<SiteLayout title="Oolong | Issa Green" description="Oolong | Issa Green">
<section class="pdp">
    <div class="section-wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/shop-tea">Tea</a><span>›</span><span aria-current="page">Oolong</span></nav>
      <div class="pdp-grid">
        <div class="pdp-gallery">
          <div class="pdp-main"><img id="pdp-main" src="/images/shop/oolong-32g.jpg" alt="Oolong"></div>
          <div class="pdp-thumbs" id="pdp-thumbs"></div>
        </div>
        <div class="pdp-info">
          <div class="pdp-ribbons"></div>
          <h1>Oolong</h1>
          <p class="pdp-sub">Other tea</p>
          <div class="pdp-price" id="pdp-price" aria-live="polite"></div>
          <div class="pdp-opt" id="pdp-opt"></div>
          <div class="pdp-buy">
            <div class="qty" role="group" aria-label="Quantity"><button type="button" id="q-dec" aria-label="Decrease quantity">−</button><output id="q-out" aria-live="polite">1</output><button type="button" id="q-inc" aria-label="Increase quantity">+</button></div>
            <button class="pdp-add" id="pdp-add" type="button"></button>
          </div>
          <p class="pdp-msg" id="pdp-msg" role="alert" hidden></p>
          <p class="pdp-note">Shipping and taxes calculated at checkout. <a href="/shipping">Shipping &amp; returns</a></p>
          <p class="pdp-lead">Unique Japanese tea, sourced directly from farmers.</p>
          
          <div class="acc-list"><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc0">Shipping info<span aria-hidden="true"></span></button><div class="acc-panel" id="acc0" role="region"><div class="acc-in"><p><strong>Calgary</strong> Within Calgary city limit: $7 flat rate. Free delivery over $75.</p><p><strong>Rest of Canada</strong> $12 flat rate shipping by Canada Post or courier service. Free shipping over $150.</p><p>If you prefer another shipping method, please do not hesitate to contact us. We will arrange a special shipment.</p></div></div></div><div class="acc"><button class="acc-btn" type="button" aria-expanded="false" aria-controls="acc1">Return &amp; refund policy<span aria-hidden="true"></span></button><div class="acc-panel" id="acc1" role="region"><div class="acc-in"><p><strong>Tea</strong> Due to the character of our products, we cannot accept returns or refunds of packaged tea and food.</p><p><strong>Tea ware &amp; goods</strong> We accept returns and issue a gift card for the same amount as the purchased goods. Customers pay the postage for returns.</p><p>Please inform us about defects immediately by email at <a href="mailto:issagreentea@gmail.com">issagreentea@gmail.com</a>. We will make an exchange as soon as possible.</p><p>Most of our products are handcrafted and have unique characters. We are happy to tell you the exact condition of each item before shipping. Please leave the request on the checkout page.</p></div></div></div></div>
        </div>
      </div>
    </div>
  </section>
  <section class="pdp-rel"><div class="section-wrap"><p class="section-label">More tea</p><div class="rel-grid"><a class="rel-card" href="/products/fukamushi-sencha"><span class="rel-img"><img src="/images/shop/fukamushi-sencha-bags.jpg" alt="" loading="lazy"></span><span class="rel-name">Fukamushi sencha</span><span class="rel-price">From $22.00</span></a><a class="rel-card" href="/products/premium-sencha"><span class="rel-img"><img src="/images/shop/premium-sencha-80g.jpg" alt="" loading="lazy"></span><span class="rel-name">Premium sencha</span><span class="rel-price">$24.50</span></a><a class="rel-card" href="/products/gyokuro"><span class="rel-img"><img src="/images/shop/gyokuro-30g.jpg" alt="" loading="lazy"></span><span class="rel-name">Gyokuro</span><span class="rel-price">Out of stock</span></a><a class="rel-card" href="/products/fukamushi-genmaicha"><span class="rel-img"><img src="/images/shop/fukamushi-genmaicha-80g.jpg" alt="" loading="lazy"></span><span class="rel-name">Fukamushi Genmaicha</span><span class="rel-price">From $19.80</span></a></div>
    <p style="text-align:center;margin-top:36px"><a class="btn-explore" href="/shop-tea">All tea</a></p></div></section>
  
  
<script is:inline>window.PDP = {"name": "Oolong", "optname": null, "variants": [{"id": "oolong-loose-tea-32g", "label": "Loose tea 32g", "price": null, "was": null, "soldout": true, "img": "/images/shop/oolong-32g.jpg", "imgs": ["/images/shop/oolong-32g.jpg"], "name": "Oolong", "variant": "Loose tea 32g"}]};</script>
<script is:inline src="/pdp.js"></script>
</SiteLayout>
